+    fn inspect_follows_chunks_and_counts_only_executed_ops() {
+        let copy = BytecodeOp::Copy as u32;
+        let mem = BytecodeOp::Mem as u32;
+        let tape = [255, 0, copy, 0, 255, 4, copy, 0, mem, 0, 255, u32::MAX];
+        assert_eq!(inspect(&tape, 0), (2, 1));
+    }
+}
