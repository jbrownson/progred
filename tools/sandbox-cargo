#!/bin/sh

set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(dirname "$tool_dir")
build_root="$project_root/target/sandbox"
cargo_home="$build_root/cargo-home"
sandbox_home="$build_root/home"
sandbox_tmp="$build_root/tmp"
target_dir="$build_root/build"
user_name=$(id -un)

rustup_path=$(command -v rustup 2>/dev/null || true)
if [ -z "$rustup_path" ]; then
    for candidate in "$HOME/.cargo/bin/rustup" /opt/homebrew/bin/rustup /usr/local/bin/rustup; do
        if [ -x "$candidate" ]; then
            rustup_path=$candidate
            break
        fi
    done
fi
if [ -z "$rustup_path" ]; then
    echo "rustup was not found; install it or add it to PATH" >&2
    exit 1
fi

if [ "$(uname -s)" != Darwin ]; then
    echo "sandbox-cargo currently requires macOS sandbox-exec" >&2
    exit 1
fi

cargo_path=$("$rustup_path" which cargo --toolchain stable)
rustc_path=$("$rustup_path" which rustc --toolchain stable)
rustdoc_path=$("$rustup_path" which rustdoc --toolchain stable)
toolchain_root=$(dirname "$(dirname "$cargo_path")")

mkdir -p "$cargo_home" "$sandbox_home" "$sandbox_tmp" "$target_dir"

# In a linked worktree Cargo's ancestor-directory config search also reads
# the main checkout's .cargo/config.toml; allow that single file.
main_git_dir=$(cd "$project_root" && /usr/bin/git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "$project_root/.git")
ancestor_cargo_config=$(dirname "$main_git_dir")/.cargo/config.toml

run_sandboxed() {
    allow_network=$1
    offline=$2
    allow_lock_write=$3
    shift 3
    env -i \
        CARGO_HOME="$cargo_home" \
        CARGO_NET_OFFLINE="$offline" \
        CARGO_TARGET_DIR="$target_dir" \
        HOME="$sandbox_home" \
        LOGNAME="$user_name" \
        PATH="$toolchain_root/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
        RUSTC="$rustc_path" \
        RUSTC_WRAPPER= \
        RUSTDOC="$rustdoc_path" \
        TMPDIR="$sandbox_tmp" \
        USER="$user_name" \
        /usr/bin/sandbox-exec \
            -D "ALLOW_NETWORK=$allow_network" \
            -D "ALLOW_LOCK_WRITE=$allow_lock_write" \
            -D "PROJECT_ROOT=$project_root" \
            -D "GIT_DIR=$project_root/.git" \
            -D "CLAUDE_DIR=$project_root/.claude" \
            -D "CODEX_DIR=$project_root/.codex" \
            -D "DOTENV=$project_root/.env" \
            -D "LOCKFILE=$project_root/Cargo.lock" \
            -D "BUILD_ROOT=$build_root" \
            -D "SANDBOX_HOME=$sandbox_home" \
            -D "SANDBOX_TMP=$sandbox_tmp" \
            -D "TOOLCHAIN_ROOT=$toolchain_root" \
            -D "ANCESTOR_CARGO_CONFIG=$ancestor_cargo_config" \
            -f "$tool_dir/cargo-sandbox.sb" \
            "$@"
}

use_minimum_age_toolchain() {
    cargo_path=$("$rustup_path" which cargo --toolchain nightly-2026-08-27)
    rustc_path=$("$rustup_path" which rustc --toolchain nightly-2026-08-27)
    rustdoc_path=$("$rustup_path" which rustdoc --toolchain nightly-2026-08-27)
    toolchain_root=$(dirname "$(dirname "$cargo_path")")
}

if [ "${1-}" = fetch ]; then
    shift
    run_sandboxed 1 false 0 "$cargo_path" fetch --locked "$@"
    exit
fi

if [ "${1-}" = update ]; then
    shift
    use_minimum_age_toolchain
    run_sandboxed 1 false 1 "$cargo_path" update -Z min-publish-age \
        --config 'registry.global-min-publish-age="7 days"' "$@"
    exit
fi

if [ "${1-}" = resolve ]; then
    shift
    use_minimum_age_toolchain
    run_sandboxed 1 false 1 "$cargo_path" metadata -Z min-publish-age \
        --config 'registry.global-min-publish-age="7 days"' \
        --format-version 1 "$@" >/dev/null
    exit
fi

if [ "${1-}" = audit ]; then
    shift
    audit_path="$cargo_home/bin/cargo-audit"
    if [ ! -x "$audit_path" ]; then
        run_sandboxed 1 false 0 "$cargo_path" install cargo-audit \
            --version '=0.22.2' --locked --no-default-features --root "$cargo_home"
    fi
    run_sandboxed 1 false 0 "$audit_path" audit --file "$project_root/Cargo.lock" "$@"
    exit
fi

if [ "$#" -eq 0 ]; then
    echo "usage: tools/sandbox-cargo audit | fetch | update | resolve | <cargo command> [arguments...]" >&2
    exit 2
fi

run_sandboxed 0 true 0 "$cargo_path" --frozen "$@"
