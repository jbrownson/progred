#!/bin/sh

set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(dirname "$tool_dir")

if [ "$(uname -s)" != Linux ]; then
    echo "run-linux requires Linux" >&2
    exit 1
fi

exec env \
    CARGO_NET_OFFLINE=false \
    CARGO_TARGET_DIR="$project_root/target/native" \
    PROGRED_COMMIT="$("$tool_dir/progred-commit")" \
    RUSTC_WRAPPER= \
    cargo run --release --locked -p progred -- "$@"
