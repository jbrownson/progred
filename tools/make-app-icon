#!/bin/sh

# Regenerate macos/AppIcon.icns from assets/progred-icon.svg.

set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(dirname "$tool_dir")
svg="$project_root/assets/progred-icon.svg"
icns="$project_root/macos/AppIcon.icns"

if [ "$(uname -s)" != Darwin ]; then
    echo "make-app-icon requires macOS" >&2
    exit 1
fi

work=$(/usr/bin/mktemp -d)
cleanup() {
    /bin/rm -rf -- "$work"
}
trap cleanup EXIT HUP INT TERM

# The macOS icon grid: the tile spans 824/1024 of the canvas, margins
# transparent. Wrap the tile art (everything inside the svg element, which
# opens on the first line and closes on the last) in that placement, then
# rasterize the vector at every ladder size.
{
    printf '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024">\n'
    printf '<g transform="translate(100 100) scale(0.8046875)">\n'
    /usr/bin/sed '1d;$d' "$svg"
    printf '</g>\n</svg>\n'
} > "$work/padded.svg"

/bin/mkdir "$work/AppIcon.iconset"
for entry in 16x16:16 16x16@2x:32 32x32:32 32x32@2x:64 \
    128x128:128 128x128@2x:256 256x256:256 256x256@2x:512 \
    512x512:512 512x512@2x:1024; do
    name=${entry%:*}
    size=${entry#*:}
    /usr/bin/qlmanage -t -s "$size" -o "$work" "$work/padded.svg" >/dev/null
    /bin/mv "$work/padded.svg.png" "$work/AppIcon.iconset/icon_$name.png"
done

/usr/bin/iconutil -c icns -o "$icns" "$work/AppIcon.iconset"
echo "wrote $icns"
