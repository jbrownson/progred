#!/usr/bin/env python3
"""Say when the last check logged in docs/dependency-checks.md is more than a
week old. A Claude Code session-start hook runs this; it prints nothing when a
check is recent."""

import datetime
import re
from pathlib import Path

LOG = Path(__file__).resolve().parent.parent / "docs" / "dependency-checks.md"


def main():
    text = LOG.read_text() if LOG.exists() else ""
    dates = [datetime.date.fromisoformat(d) for d in re.findall(r"^- (\d{4}-\d{2}-\d{2})", text, re.M)]
    last = max(dates, default=None)
    if last is None:
        print("No dependency and security check is logged in docs/dependency-checks.md. "
              "Suggest one to the user.")
    elif (age := (datetime.date.today() - last).days) > 7:
        print(f"The last dependency and security check was {age} days ago, on {last}. "
              "Suggest one to the user; docs/dependency-checks.md describes it.")


if __name__ == "__main__":
    main()
