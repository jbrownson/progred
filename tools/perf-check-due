#!/usr/bin/env python3
"""Say when the last run recorded in docs/performance-log.tsv is more than a
week old. A Claude Code session-start hook runs this; it prints nothing when a
run is recent."""

import csv
import datetime
from pathlib import Path

LOG = Path(__file__).resolve().parent.parent / "docs" / "performance-log.tsv"


def main():
    with LOG.open(newline="") as file:
        dates = [datetime.date.fromisoformat(row["date"][:10]) for row in csv.DictReader(file, delimiter="\t")]
    last = max(dates, default=None)
    if last is None:
        print("No performance run is recorded in docs/performance-log.tsv. Suggest the weekly check.")
    elif (age := (datetime.date.today() - last).days) > 7:
        print(f"The last recorded performance run was {age} days ago, on {last}. Suggest the "
              "weekly check to the user; docs/performance.md describes it.")


if __name__ == "__main__":
    main()
