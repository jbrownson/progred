#!/bin/sh

# Locked Cargo for Linux in a namespace sandbox, the counterpart of
# tools/sandbox-cargo's Seatbelt one: build scripts, procedural macros and
# tests see a read-only system without the home directory, other processes or
# (except while fetching) the network, and write only beneath target/sandbox.
# tools/linux-sandbox sets that up. This is the single deliberate Linux
# exception to the .cargo/config.toml tripwire; see docs/build-security.md.

set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(dirname "$tool_dir")
build_root="$project_root/target/sandbox"
cargo_home="$build_root/cargo-home"
sandbox_home="$build_root/home"
sandbox_tmp="$build_root/tmp"
target_dir="$build_root/build"
user_name=$(id -un)

if [ "$(uname -s)" != Linux ]; then
    echo "linux-cargo requires Linux; use tools/sandbox-cargo on macOS" >&2
    exit 1
fi

if [ "$#" -eq 0 ]; then
    echo "usage: tools/linux-cargo audit | fetch | update | resolve | <cargo command> [arguments...]" >&2
    exit 2
fi

case $project_root in
    /tmp/* | /run/* | /var/tmp/* | /dev/shm/*)
        echo "linux-cargo: the build sandbox hides $project_root; move the checkout" >&2
        exit 1
        ;;
esac

for tool in unshare setpriv setsid findmnt pivot_root; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "linux-cargo: the build sandbox needs $tool, from util-linux" >&2
        exit 1
    fi
done
if ! unshare --user --map-root-user true 2>/dev/null; then
    cat >&2 <<'EOF'
linux-cargo: the build sandbox needs unprivileged user namespaces, which this
system doesn't allow. Some distributions restrict them; on Ubuntu, AppArmor
does (kernel.apparmor_restrict_unprivileged_userns). See docs/build-security.md.
EOF
    exit 1
fi

rustup_path=$(command -v rustup 2>/dev/null || true)
if [ -z "$rustup_path" ] && [ -x "$HOME/.cargo/bin/rustup" ]; then
    rustup_path=$HOME/.cargo/bin/rustup
fi

use_toolchain() {
    if [ -n "$rustup_path" ]; then
        cargo_path=$("$rustup_path" which cargo --toolchain "$1")
    elif [ "$1" = stable ] && command -v cargo >/dev/null 2>&1; then
        cargo_path=$(command -v cargo)
    else
        echo "linux-cargo: rustup was not found; install it or add it to PATH" >&2
        exit 1
    fi
    cargo_path=$(readlink -f "$cargo_path")
    toolchain_root=$(dirname "$(dirname "$cargo_path")")
}
use_toolchain stable

mkdir -p "$cargo_home" "$sandbox_home" "$sandbox_tmp" "$target_dir"

# Release builds carry the commit they came from, since they're what people
# run and share. Development builds, tests included, leave it out: progred's
# source reads it, so every commit would otherwise rebuild progred.
stamp() {
    for arg in "$@"; do
        case $arg in
            --) return ;;
            --release | -r) "$tool_dir/progred-commit"; return ;;
        esac
    done
}

# Steps with network access also get a proxy's settings, its certificate
# bundle, and the resolver configuration, which often lives under /run.
run_sandboxed() {
    allow_network=$1
    allow_lock_write=$2
    shift 2
    stamp=$(stamp "$@")
    set -- -- "$@"
    if [ "$allow_network" = 1 ]; then
        network= offline=false
        https_upper=${HTTPS_PROXY-} https_lower=${https_proxy-}
        all_upper=${ALL_PROXY-} all_lower=${all_proxy-}
        no_upper=${NO_PROXY-} no_lower=${no_proxy-}
        cargo_ca=${CARGO_HTTP_CAINFO-} ssl_ca=${SSL_CERT_FILE-}
        for file in "$cargo_ca" "$ssl_ca" "$(readlink -f /etc/resolv.conf 2>/dev/null || true)"; do
            if [ -f "$file" ]; then
                set -- "$file" "$@"
            fi
        done
    else
        network=--net offline=true
        https_upper= https_lower= all_upper= all_lower= no_upper= no_lower=
        cargo_ca= ssl_ca=
    fi
    env -i \
        CARGO_HOME="$cargo_home" \
        CARGO_NET_OFFLINE="$offline" \
        CARGO_TARGET_DIR="$target_dir" \
        HOME="$sandbox_home" \
        LOGNAME="$user_name" \
        PATH="$toolchain_root/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
        PROGRED_COMMIT="$stamp" \
        RUSTC="$toolchain_root/bin/rustc" \
        RUSTC_WRAPPER= \
        RUSTDOC="$toolchain_root/bin/rustdoc" \
        TMPDIR="$sandbox_tmp" \
        USER="$user_name" \
        ${https_upper:+"HTTPS_PROXY=$https_upper"} \
        ${https_lower:+"https_proxy=$https_lower"} \
        ${all_upper:+"ALL_PROXY=$all_upper"} \
        ${all_lower:+"all_proxy=$all_lower"} \
        ${no_upper:+"NO_PROXY=$no_upper"} \
        ${no_lower:+"no_proxy=$no_lower"} \
        ${cargo_ca:+"CARGO_HTTP_CAINFO=$cargo_ca"} \
        ${ssl_ca:+"SSL_CERT_FILE=$ssl_ca"} \
        unshare --user --map-root-user --mount $network --pid --fork --mount-proc \
        "$tool_dir/linux-sandbox" "$project_root" "$build_root" "$toolchain_root" \
            "$HOME" "$allow_lock_write" "$@"
}

if [ "$1" = fetch ]; then
    shift
    run_sandboxed 1 0 "$cargo_path" fetch --locked "$@"
    exit
fi

# Updates exclude registry releases less than seven days old, as
# sandbox-cargo's do, with the toolchain the browser build pins. Resolution
# runs no dependency code.
if [ "$1" = update ]; then
    shift
    . "$tool_dir/web-build-settings.sh"
    use_toolchain "$web_toolchain"
    run_sandboxed 1 1 "$cargo_path" update -Z min-publish-age \
        --config 'registry.global-min-publish-age="7 days"' "$@"
    exit
fi

# After declaring a dependency, record it in Cargo.lock from the local cache
# alone, so no newly published registry release can enter the graph.
if [ "$1" = resolve ]; then
    shift
    run_sandboxed 0 1 "$cargo_path" --offline metadata --format-version 1 "$@" >/dev/null
    exit
fi

# The pinned advisory scanner, installed from its lockfile on first use. The
# installation builds with network access, as on macOS.
if [ "$1" = audit ]; then
    shift
    audit_path="$cargo_home/bin/cargo-audit"
    if [ ! -x "$audit_path" ]; then
        run_sandboxed 1 0 "$cargo_path" install cargo-audit \
            --version '=0.22.2' --locked --no-default-features --root "$cargo_home"
    fi
    run_sandboxed 1 0 "$audit_path" audit --file "$project_root/Cargo.lock" "$@"
    exit
fi

# Builds are offline; fetch the locked graph first if anything is missing.
# Fetching runs no dependency code.
if ! run_sandboxed 0 0 "$cargo_path" fetch --frozen --quiet 2>/dev/null; then
    run_sandboxed 1 0 "$cargo_path" fetch --locked
fi
run_sandboxed 0 0 "$cargo_path" --frozen "$@"
