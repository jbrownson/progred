#!/bin/sh

# Locked Cargo for Linux in a namespace sandbox, the counterpart of
# tools/sandbox-cargo's Seatbelt one: build scripts, procedural macros and
# tests see a read-only system without the home directory, other processes or
# (except while fetching) the network, and write only beneath target/sandbox.
# tools/linux-sandbox sets that up, and tools/cargo-common.sh holds the
# commands the two wrappers share. This is the single deliberate Linux
# exception to the .cargo/config.toml tripwire; see docs/build-security.md.

set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ "$(uname -s)" != Linux ]; then
    echo "linux-cargo requires Linux; use tools/sandbox-cargo on macOS" >&2
    exit 1
fi

. "$tool_dir/cargo-common.sh"

case $project_root in
    /tmp/* | /run/* | /var/tmp/* | /dev/shm/*)
        echo "linux-cargo: the build sandbox hides $project_root; move the checkout" >&2
        exit 1
        ;;
esac

for tool in unshare setpriv setsid findmnt pivot_root; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "linux-cargo: the build sandbox needs $tool, from util-linux" >&2
        exit 1
    fi
done
if ! unshare --user --map-root-user true 2>/dev/null; then
    cat >&2 <<'EOF'
linux-cargo: the build sandbox needs unprivileged user namespaces, which this
system doesn't allow. Some distributions restrict them; on Ubuntu, AppArmor
does (kernel.apparmor_restrict_unprivileged_userns). See docs/build-security.md.
EOF
    exit 1
fi

# Steps with network access also get a proxy's settings, its certificate
# bundle, and the resolver configuration, which often lives under /run.
run_sandboxed() {
    allow_network=$1
    allow_lock_write=$2
    shift 2
    stamp=$(stamp "$@")
    set -- -- "$@"
    if [ "$allow_network" = 1 ]; then
        network= offline=false
        https_upper=${HTTPS_PROXY-} https_lower=${https_proxy-}
        all_upper=${ALL_PROXY-} all_lower=${all_proxy-}
        no_upper=${NO_PROXY-} no_lower=${no_proxy-}
        cargo_ca=${CARGO_HTTP_CAINFO-} ssl_ca=${SSL_CERT_FILE-}
        for file in "$cargo_ca" "$ssl_ca" "$(readlink -f /etc/resolv.conf 2>/dev/null || true)"; do
            if [ -f "$file" ]; then
                set -- "$file" "$@"
            fi
        done
    else
        network=--net offline=true
        https_upper= https_lower= all_upper= all_lower= no_upper= no_lower=
        cargo_ca= ssl_ca=
    fi
    env -i \
        CARGO_HOME="$cargo_home" \
        CARGO_NET_OFFLINE="$offline" \
        CARGO_TARGET_DIR="$target_dir" \
        HOME="$sandbox_home" \
        LOGNAME="$user_name" \
        PATH="$toolchain_root/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
        PROGRED_COMMIT="$stamp" \
        RUSTC="$rustc_path" \
        RUSTC_WRAPPER= \
        RUSTDOC="$rustdoc_path" \
        TMPDIR="$sandbox_tmp" \
        USER="$user_name" \
        ${https_upper:+"HTTPS_PROXY=$https_upper"} \
        ${https_lower:+"https_proxy=$https_lower"} \
        ${all_upper:+"ALL_PROXY=$all_upper"} \
        ${all_lower:+"all_proxy=$all_lower"} \
        ${no_upper:+"NO_PROXY=$no_upper"} \
        ${no_lower:+"no_proxy=$no_lower"} \
        ${cargo_ca:+"CARGO_HTTP_CAINFO=$cargo_ca"} \
        ${ssl_ca:+"SSL_CERT_FILE=$ssl_ca"} \
        unshare --user --map-root-user --mount $network --pid --fork --mount-proc \
        "$tool_dir/linux-sandbox" "$project_root" "$build_root" "$toolchain_root" \
            "$HOME" "$allow_lock_write" "$@"
}

cargo_command "$@"
