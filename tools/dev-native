#!/usr/bin/env python3

r"""Rebuild after app exit or Ctrl+C; stop on Ctrl+\ or terminal exit.

With --pull, each build first fast-forwards the checked-out branch to its
upstream, showing git's output and the commits that arrived; where it can't,
it builds what's here.
"""

import os
from collections import deque
from pathlib import Path
import signal
import subprocess
import sys
import time


def stop(process):
    if process.poll() is None:
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.wait()


def git(arguments, requests, shown=False):
    """Run git here, its output kept, or shown as it runs; None if a request
    stopped it first."""
    process = subprocess.Popen(
        ["git", *arguments],
        stdout=None if shown else subprocess.PIPE,
        stderr=None if shown else subprocess.STDOUT,
        text=True,
        start_new_session=True,
        env={**os.environ, "GIT_TERMINAL_PROMPT": "0"},
    )
    while True:
        try:
            output, _ = process.communicate(timeout=0.05)
            return process.returncode, (output or "").strip()
        except subprocess.TimeoutExpired:
            if requests:
                stop(process)
                process.communicate()
                return None


def pull(requests):
    """Fast-forward the checked-out branch to its upstream, never merging,
    git's own output shown: then the commits that arrived, or that it
    builds what's here."""
    head = git(["rev-parse", "HEAD"], requests)
    if not head:
        return
    print("git pull --ff-only", flush=True)
    pulled = git(["pull", "--ff-only"], requests, shown=True)
    if not pulled:
        return
    if pulled[0] != 0:
        print("Not pulled. Building what's here.", flush=True)
        return
    arrived = git(["log", "--oneline", "--reverse", f"{head[1]}..HEAD"], requests)
    if arrived and arrived[1]:
        print(f"Pulled:\n{arrived[1]}", flush=True)


def develop(commands, pulling=False):
    requests = deque()

    def request(signum, _):
        requests.append(signum)

    previous = {
        signum: signal.signal(signum, request)
        for signum in (signal.SIGINT, signal.SIGQUIT, signal.SIGTERM, signal.SIGHUP)
    }
    try:
        print("Quit the app or press Ctrl+C to rebuild; Ctrl+\\ quits this session", flush=True)
        while True:
            if requests and requests.popleft() != signal.SIGINT:
                return 0
            status = 0
            if pulling:
                pull(requests)
            for command in commands:
                if requests:
                    break
                try:
                    process = subprocess.Popen(command, start_new_session=True)
                except OSError as error:
                    print(error, file=sys.stderr)
                    status = 1
                    break
                try:
                    while process.poll() is None and not requests:
                        time.sleep(0.05)
                finally:
                    stop(process)
                status = process.returncode
                if status != 0:
                    break
            if not requests:
                if status == 0:
                    print("Progred exited. Rebuilding and restarting.", flush=True)
                else:
                    print(f"Command failed ({status}). Ctrl+C retries; Ctrl+\\ quits", flush=True)
                    while not requests:
                        time.sleep(0.1)
    finally:
        for signum, handler in previous.items():
            signal.signal(signum, handler)


def main():
    if not sys.stdin.isatty():
        print("make dev needs an interactive terminal; use make run for a single run", file=sys.stderr)
        return 2
    arguments = sys.argv[1:]
    pulling = "--pull" in arguments
    arguments = [argument for argument in arguments if argument != "--pull"]
    root = Path(__file__).resolve().parent.parent
    os.chdir(root)
    if sys.platform == "darwin":
        commands = [
            [str(root / "tools/build-macos-app")],
            ["/usr/bin/swift", str(root / "tools/run-macos.swift"),
             str(root / "target/sandbox/app/Progred.app")],
        ]
    elif sys.platform == "linux":
        commands = [[str(root / "tools/run-linux"), *arguments]]
    else:
        print(f"native Progred is not supported on {sys.platform}", file=sys.stderr)
        return 2
    return develop(commands, pulling)


if __name__ == "__main__":
    sys.exit(main())
