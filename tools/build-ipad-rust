#!/bin/sh

set -eu

tool_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
project_root=$(dirname "$tool_dir")

case "${PLATFORM_NAME-}" in
    iphonesimulator)
        rust_target=aarch64-apple-ios-sim
        ;;
    iphoneos)
        rust_target=aarch64-apple-ios
        ;;
    *)
        echo "unsupported Xcode platform: ${PLATFORM_NAME-<unset>}" >&2
        exit 2
        ;;
esac

PATH="${HOME}/.cargo/bin:${PATH}" \
    "$tool_dir/sandbox-cargo" build --release -p progred --lib --target "$rust_target"

generated_dir="$project_root/target/ios/generated"
generated_header="$generated_dir/rust-build.h"
library_hash=$(/usr/bin/shasum -a 256 "${PROGRED_RUST_LIBRARY:?}")
library_hash=${library_hash%% *}
expected="#define PROGRED_RUST_LIBRARY_HASH \"$library_hash\""

mkdir -p "$generated_dir"
if [ ! -f "$generated_header" ] || ! /usr/bin/grep -Fqx "$expected" "$generated_header"; then
    /usr/bin/printf '%s\n' "$expected" >"$generated_header"
fi
