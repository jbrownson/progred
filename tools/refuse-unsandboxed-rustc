#!/bin/sh

# Cargo calls this in place of rustc outside the build sandbox, through
# .cargo/config.toml, with the real rustc and its arguments. Questions about
# the compiler and target, which compile nothing, pass through, so `cargo
# metadata` works; anything that would compile is refused.

set -eu

rustc=$1
shift

query=0
for argument do
    case $argument in
        -vV | -V | --version) query=1 ;;
        --print | --print=*) query=1 ;;
        *.rs) query=0; break ;;
    esac
done
if [ "$query" = 1 ]; then
    exec "$rustc" "$@"
fi

cat >&2 <<'MESSAGE'
error: an unsandboxed Rust build was refused by this repository

Cargo build scripts and procedural macros execute native dependency code.
Use one of the repository's entry points instead, for example:

    make run
    make check
    make test
    ./tools/sandbox-cargo <cargo command> [arguments...]   (macOS, sandboxed)
    ./tools/linux-cargo <cargo command> [arguments...]     (Linux, sandboxed)
MESSAGE

exit 86
